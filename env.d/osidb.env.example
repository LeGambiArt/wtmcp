# OSIDB plugin configuration
#
# Copy this file to osidb.env and uncomment the variables you need:
#   cp osidb.env.example osidb.env

# OSIDB instance URL (required)
#OSIDB_URL=https://your-osidb-instance.example.com

# Auth type: auto, kerberos, token
# "auto" tries Kerberos first, falls back to token.
#OSIDB_AUTH_TYPE=auto

# --- Kerberos ---
# Uses your existing Kerberos ticket (kinit).
# No additional configuration needed beyond OSIDB_URL.

# --- Bearer Token ---
# Set OSIDB_AUTH_TYPE=token and provide a token
#OSIDB_TOKEN=your-bearer-token
